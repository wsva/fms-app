{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fms-app",
  "version": "0.1.0",
  "identifier": "com.wsva.fms-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:30000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "fms-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/audiowaveform"
    ]
  }
}
