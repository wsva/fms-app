{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FmS",
  "version": "0.1.0",
  "identifier": "com.wsva.fms-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:30000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "FmS",
        "url": "home",
        "width": 800,
        "height": 600,
        "maximized": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 wsva",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RTA0RTE1NEE2NTYwMEMKUldRTVlHVktGVTdnUjM4MHhKZXlmRHBOZnoxL0V5U2Y5bHBQOGxHd09tL0lNSGkzS0U3cnJFOGwK",
      "endpoints": [
        "https://github.com/wsva/fms-app/releases/latest/download/latest.json",
        "https://lusworkshop.site/mirror/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "shell": {
      "open": true
    },
    "deep-link": {
      "schemes": ["fms-app"]
    }
  }
}
